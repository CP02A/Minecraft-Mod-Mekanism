{
  "schemaVersion": 1,
  "id": "mekanism",
  "version": "${version}",
  "name": "Mekanism",
  "description": "Mekanism is a Minecraft add-on featuring high-tech machinery that can be used to create powerful tools, armor, and weapons.",
  "authors": [
    "Aidancbrady",
    "Thommy101",
    "Thiakil",
    "pupnewfster",
    "dizzyd"
  ],
  "contributors": [
    "unpairedbracket",
    "CyanideX",
    "Ridanisaurus"
  ],
  "contact": {
    "homepage": "https://aidancbrady.com/mekanism/",
    "sources": "https://github.com/mekanism/Mekanism",
    "issues": "https://github.com/mekanism/Mekanism/issues"
  },
  "license": "MIT",
  "icon": "assets/mekanism/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mekanism.fabric.MekanismFabric"
    ],
    "client": [
      "mekanism.fabric.MekanismFabricClient"
    ],
    "mekanism_shim": [
      "mekanism.fabric.MekanismShimMod"
    ],
    "mekanism_shim_client": [
      "mekanism.fabric.MekanismShimClientMod"
    ],
    "jei_mod_plugin": [
      "mekanism.client.recipe_viewer.jei.MekanismJEI",
      "mekanism.fabric.integration.jei.MekanismFabricJeiPlugin"
    ],
    "jade": [
      "mekanism.common.integration.lookingat.jade.MekanismJadePlugin"
    ],
    "theoneprobe": [
      "mekanism.common.integration.lookingat.theoneprobe.MekanismTOPPlugin"
    ],
    "mekanism:computercraft": [
      "mekanism.fabric.integration.computercraft.MekanismComputerCraftShim"
    ]
  },
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "minecraft": "~26.3",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "forgeconfigapiport": "*",
    "team_reborn_energy": "*"
  },
  "suggests": {
    "jei": "*",
    "jade": "*",
    "theoneprobe": "*",
    "wthit": "*",
    "computercraft": "*"
  },
  "custom": {
