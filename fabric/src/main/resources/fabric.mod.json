{
  "schemaVersion": 1,
  "id": "mekanism",
  "version": "${version}",
  "name": "Mekanism",
  "description": "Mekanism is a Minecraft add-on featuring high-tech machinery that can be used to create powerful tools, armor, and weapons.",
  "authors": ["Aidancbrady", "Thommy101", "Thiakil", "pupnewfster", "dizzyd"],
  "contributors": ["unpairedbracket", "CyanideX", "Ridanisaurus"],
  "contact": {
    "homepage": "https://aidancbrady.com/mekanism/",
    "sources": "https://github.com/mekanism/Mekanism",
    "issues": "https://github.com/mekanism/Mekanism/issues"
  },
  "license": "MIT",
  "icon": "assets/mekanism/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["mekanism.fabric.MekanismFabric"],
    "client": ["mekanism.fabric.MekanismFabricClient"]
  },
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "minecraft": "~26.3",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
